{
  "name": "@sbissoli/mcp-provenance",
  "version": "0.1.0",
  "description": "Contrato de proveniência para servidores MCP: todo retorno de tool carrega fonte, endpoint, período, data de extração e licença, em dois modos (concise/detailed), com serialização determinística",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SidneyBissoli/mcp-br-commons.git",
    "directory": "packages/mcp-provenance"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "docs",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "zod": "^4.5.4"
  },
  "keywords": [
    "mcp",
    "provenance",
    "data-provenance",
    "open-data",
    "attribution"
  ],
  "author": "Sidney Bissoli <sbissoli76@gmail.com>",
  "license": "MIT"
}
