{
  "name": "@sbissoli/mcp-stats",
  "version": "0.3.0",
  "description": "Motor de estatísticas para tools MCP tabulares: média/mediana/distribuição/percentis/topN/agruparPor computados no servidor, com camada de exibição por idioma. Zero dependências.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SidneyBissoli/mcp-br-commons.git",
    "directory": "packages/mcp-stats"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "keywords": [
    "mcp",
    "statistics",
    "percentiles",
    "aggregation",
    "open-data"
  ],
  "author": "Sidney Bissoli <sbissoli76@gmail.com>",
  "license": "MIT"
}
