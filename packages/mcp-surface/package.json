{
  "name": "@sbissoli/mcp-surface",
  "version": "0.5.1",
  "description": "Impressão digital da superfície de um servidor MCP: initialize (instructions + capabilities) + tools/resources/prompts + quem responde sem token, travados ao lado da versão — mudou sem subir a versão = build vermelho e deploy recusado; mais a conferência do endpoint no ar e o replay das versões publicadas",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SidneyBissoli/mcp-br-commons.git",
    "directory": "packages/mcp-surface"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./cliente": {
      "types": "./dist/cliente.d.ts",
      "default": "./dist/cliente.js"
    },
    "./card": {
      "types": "./dist/card.d.ts",
      "default": "./dist/card.js"
    },
    "./card/http": {
      "types": "./dist/card-http.d.ts",
      "default": "./dist/card-http.js"
    }
  },
  "bin": {
    "mcp-surface": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "SPEC.md",
    "exemplos",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "peerDependencies": {
    "@modelcontextprotocol/client": "^2.0.0",
    "@modelcontextprotocol/server": "^2.0.0"
  },
  "peerDependenciesMeta": {
    "@modelcontextprotocol/client": {
      "optional": true
    }
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.3.0",
    "@modelcontextprotocol/server": "^2.3.0"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "surface",
    "fingerprint",
    "versioning",
    "ci",
    "mcp-registry"
  ],
  "author": "Sidney da Silva Pereira Bissoli <sbissoli76@gmail.com>",
  "license": "MIT"
}
